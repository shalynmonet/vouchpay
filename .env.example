# Copy this file to .env and fill in your Airwallex sandbox credentials.
# Leave the keys blank to run with simulated payouts.

AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com

# Map each demo creator to a beneficiary you created in the Airwallex sandbox.
# Creators: cr1 = Maya Chen, cr2 = Jordan Reyes, cr3 = Ava Brooks
AIRWALLEX_BENEFICIARIES=cr1:,cr2:,cr3:

PAYOUT_CURRENCY=USD
PORT=3000
